# Backend API URL
# Copy this file to .env and update the URL for your environment

# For local development with backend on localhost:
# VITE_BACKEND_URL=http://localhost:8080

# For Azure deployment (first server):
# VITE_BACKEND_URL=http://20.208.138.248:8080

# For Azure deployment (second server):
# VITE_BACKEND_URL=http://40.68.198.73:8080

# For Docker deployment:
# VITE_BACKEND_URL=http://backend:8080

# Default value
VITE_BACKEND_URL=http://20.208.138.248:8080
